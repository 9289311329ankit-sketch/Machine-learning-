      "source": [
        "from tensorflow.keras.layers import Embedding, SimpleRNNCell\n",
        "\n",
        "# Small demo parameters\n",
        "batch_size = 1\n",
        "sequence_length = 5\n",
        "vocab_size_demo = 100\n",
        "embedding_dim_demo = 8\n",
        "hidden_units = 16\n",
        "\n",
        "# Random sample input\n",
        "sample_input = np.random.randint(0, vocab_size_demo, (batch_size, sequence_length))\n",
        "\n",
        "print(\"Sample Input:\", sample_input)\n",
        "\n",
        "# Embedding layer\n",
        "embedding_layer = Embedding(vocab_size_demo, embedding_dim_demo)\n",
        "embedded = embedding_layer(sample_input)\n",
        "\n",
        "print(\"Embedded Shape:\", embedded.shape)\n",
        "\n",
        "# Create RNN cell\n",
        "rnn_cell = SimpleRNNCell(hidden_units)\n",
        "\n",
        "# Initial hidden state\n",
        "h = tf.zeros((batch_size, hidden_units))\n",
        "\n",
        "print(\"\\nSequential Processing Begins:\\n\")\n",
        "\n",
        "# Explicit time-step loop\n",
        "for t in range(sequence_length):\n",
        "    x_t = embedded[:, t, :]\n",
        "    output, [h] = rnn_cell(x_t, [h])\n",
        "    print(f\"Time step {t+1}\")\n",
        "    print(\"Input shape:\", x_t.shape)\n",
        "    print(\"Hidden state shape:\", h.shape)\n",
        "    print(\"------\")"
      ],
