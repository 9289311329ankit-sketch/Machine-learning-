            "\n",
            "===== LIBRARY MANAGEMENT SYSTEM =====\n",
            "1. Add book              6. Register member\n",
            "2. Remove book           7. List members\n",
            "3. List books            8. Issue book\n",
            "4. Search books          9. Return book\n",
            "5. List issued books     0. Exit\n",
            "\n",
            "Choose an option: 0\n",
            "Goodbye!\n"
          ]
        }
      ],
      "source": [
        "\n",
        "import json\n",
        "import os\n",
        "from datetime import date, timedelta\n",
        "\n",
        "DATA_FILE = \"library_data.json\"\n",
        "LOAN_DAYS = 14\n",
        "FINE_PER_DAY = 1\n",
        "\n",
        "\n",
        "class Library:\n",
        "    def __init__(self):\n",
        "        self.books = {}\n",
        "        self.members = {}\n",
        "        self.load()\n",
        "\n",
        "    def load(self):\n",
        "        if os.path.exists(DATA_FILE):\n",
        "            with open(DATA_FILE, \"r\") as f:\n",
        "                data = json.load(f)\n",
        "            self.books = data.get(\"books\", {})\n",
        "            self.members = data.get(\"members\", {})\n",
        "\n",
        "    def save(self):\n",
        "        with open(DATA_FILE, \"w\") as f:\n",
        "            json.dump({\"books\": self.books, \"members\": self.members}, f, indent=2)\n",
        "\n",
        "    # ---------- books ----------\n",
        "    def add_book(self, book_id, title, author, copies=1):\n",
        "        if book_id in self.books:\n",
        "            self.books[book_id][\"copies\"] += copies\n",
        "            self.books[book_id][\"available\"] += copies\n",
        "            print(f\"Added {copies} more copies of '{self.books[book_id]['title']}'.\")\n",
        "        else:\n",
        "            self.books[book_id] = {\n",
        "                \"title\": title,\n",
        "                \"author\": author,\n",
        "                \"copies\": copies,\n",
        "                \"available\": copies,\n",
        "            }\n",
        "            print(f\"Book '{title}' added.\")\n",
        "        self.save()\n",
        "\n",
        "    def remove_book(self, book_id):\n",
        "        book = self.books.get(book_id)\n",
        "        if not book:\n",
        "            print(\"Book not found.\")\n",
        "        elif book[\"available\"] != book[\"copies\"]:\n",
        "            print(\"Cannot remove: some copies are currently issued.\")\n",
        "        else:\n",
        "            del self.books[book_id]\n",
        "            self.save()\n",
        "            print(\"Book removed.\")\n",
        "\n",
        "    def list_books(self):\n",
        "        if not self.books:\n",
        "            print(\"No books in the library.\")\n",
        "            return\n",
        "        print(f\"\\n{'ID':<8}{'Title':<30}{'Author':<22}{'Avail/Total'}\")\n",
        "        print(\"-\" * 70)\n",
        "        for bid, b in self.books.items():\n",
        "            print(f\"{bid:<8}{b['title']:<30}{b['author']:<22}{b['available']}/{b['copies']}\")\n",
        "\n",
        "    def search_books(self, keyword):\n",
        "        keyword = keyword.lower()\n",
        "        found = {\n",
        "            bid: b for bid, b in self.books.items()\n",
        "            if keyword in b[\"title\"].lower() or keyword in b[\"author\"].lower()\n",
        "        }\n",
        "        if not found:\n",
        "            print(\"No matching books.\")\n",
        "            return\n",
        "        for bid, b in found.items():\n",
        "            print(f\"[{bid}] {b['title']} by {b['author']} ({b['available']} available)\")\n",
        "\n",
        "    # ---------- members ----------\n",
        "    def add_member(self, member_id, name):\n",
        "        if member_id in self.members:\n",
        "            print(\"Member ID already exists.\")\n",
        "            return\n",
        "        self.members[member_id] = {\"name\": name, \"borrowed\": {}}\n",
        "        self.save()\n",
        "        print(f\"Member '{name}' registered.\")\n",
        "\n",
        "    def list_members(self):\n",
        "        if not self.members:\n",
        "            print(\"No members registered.\")\n",
        "            return\n",
        "        for mid, m in self.members.items():\n",
        "            print(f\"[{mid}] {m['name']} - {len(m['borrowed'])} book(s) borrowed\")\n",
        "\n",
        "    # ---------- issue / return ----------\n",
        "    def issue_book(self, book_id, member_id):\n",
        "        book = self.books.get(book_id)\n",
        "        member = self.members.get(member_id)\n",
        "        if not book or not member:\n",
        "            print(\"Invalid book ID or member ID.\")\n",
        "        elif book[\"available\"] < 1:\n",
        "            print(\"No copies available right now.\")\n",
        "        elif book_id in member[\"borrowed\"]:\n",
        "            print(\"Member already has this book.\")\n",
        "        else:\n",
        "            due = date.today() + timedelta(days=LOAN_DAYS)\n",
        "            book[\"available\"] -= 1\n",
        "            member[\"borrowed\"][book_id] = due.isoformat()\n",
        "            self.save()\n",
        "            print(f\"Issued '{book['title']}' to {member['name']}. Due: {due}\")\n",
        "\n",
        "    def return_book(self, book_id, member_id):\n",
        "        book = self.books.get(book_id)\n",
        "        member = self.members.get(member_id)\n",
        "        if not book or not member or book_id not in member[\"borrowed\"]:\n",
        "            print(\"No such issued record found.\")\n",
        "            return\n",
        "        due = date.fromisoformat(member[\"borrowed\"].pop(book_id))\n",
        "        book[\"available\"] += 1\n",
        "        self.save()\n",
        "        late_days = (date.today() - due).days\n",
        "        print(f\"'{book['title']}' returned by {member['name']}.\")\n",
        "        if late_days > 0:\n",
        "            print(f\"Overdue by {late_days} day(s). Fine: {late_days * FINE_PER_DAY}\")\n",
        "\n",
        "    def list_issued(self):\n",
        "        any_issued = False\n",
        "        for mid, m in self.members.items():\n",
        "            for bid, due in m[\"borrowed\"].items():\n",
        "                any_issued = True\n",
        "                print(f\"{m['name']} ({mid}) -> {self.books[bid]['title']} (due {due})\")\n",
        "        if not any_issued:\n",
        "            print(\"No books are currently issued.\")\n",
        "\n",
        "\n",
        "def ask_int(prompt, default=1):\n",
        "    try:\n",
        "        return int(input(prompt) or default)\n",
        "    except ValueError:\n",
        "        return default\n",
        "\n",
        "\n",
        "def main():\n",
        "    lib = Library()\n",
        "    menu = \"\"\"\n",
        "===== LIBRARY MANAGEMENT SYSTEM =====\n",
        "1. Add book              6. Register member\n",
        "2. Remove book           7. List members\n",
        "3. List books            8. Issue book\n",
        "4. Search books          9. Return book\n",
        "5. List issued books     0. Exit\n",
        "\"\"\"\n",
        "    while True:\n",
        "        print(menu)\n",
        "        choice = input(\"Choose an option: \").strip()\n",
        "\n",
        "        if choice == \"1\":\n",
        "            lib.add_book(\n",
        "                input(\"Book ID: \").strip(),\n",
        "                input(\"Title: \").strip(),\n",
        "                input(\"Author: \").strip(),\n",
        "                ask_int(\"Copies (default 1): \"),\n",
        "            )\n",
        "        elif choice == \"2\":\n",
        "            lib.remove_book(input(\"Book ID: \").strip())\n",
        "        elif choice == \"3\":\n",
        "            lib.list_books()\n",
        "        elif choice == \"4\":\n",
        "            lib.search_books(input(\"Search title/author: \").strip())\n",
        "        elif choice == \"5\":\n",
        "            lib.list_issued()\n",
        "        elif choice == \"6\":\n",
        "            lib.add_member(input(\"Member ID: \").strip(), input(\"Name: \").strip())\n",
        "        elif choice == \"7\":\n",
        "            lib.list_members()\n",
        "        elif choice == \"8\":\n",
        "            lib.issue_book(input(\"Book ID: \").strip(), input(\"Member ID: \").strip())\n",
        "        elif choice == \"9\":\n",
        "            lib.return_book(input(\"Book ID: \").strip(), input(\"Member ID: \").strip())\n",
        "        elif choice == \"0\":\n",
        "            print(\"Goodbye!\")\n",
        "            break\n",
        "        else:\n",
        "            print(\"Invalid choice, try again.\")\n",
        "\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    main()"
      ]
    }
  ]
